# RR Intelligence Hub – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rr_intelligence_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----- Application -----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ----- ML -----
MODEL_DIR=models
RETRAIN_ON_STARTUP=false

